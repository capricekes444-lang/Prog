def hoeveelheid_water(minuten: int) -> int:
    """
    >>> hoeveelheid_water(2)
    24
    >>> hoeveelheid_water(5)
    60
    >>> hoeveelheid_water(4)
    48
    >>> hoeveelheid_water(1)
    12
    >>> hoeveelheid_water(3)
    36
    """
    return minuten * 12


if __name__ == "__main__":
    minuten = int(input("Hoeveel minuten douche je?"))
    result = hoeveelheid_water(minuten)
    print(result)